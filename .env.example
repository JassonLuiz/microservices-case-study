# Copie este arquivo para ".env" (fora do Git) e ajuste os valores para o seu
# ambiente local. Nenhum destes valores tem efeito fora do docker-compose local.

# --- PostgreSQL - User Service ---
POSTGRES_USER_DB=user_db
POSTGRES_USER_USER=user_service
POSTGRES_USER_PASSWORD=changeme

# --- PostgreSQL - Order Service ---
POSTGRES_ORDER_DB=order_db
POSTGRES_ORDER_USER=order_service
POSTGRES_ORDER_PASSWORD=changeme

# --- PostgreSQL - Payment Service ---
POSTGRES_PAYMENT_DB=payment_db
POSTGRES_PAYMENT_USER=payment_service
POSTGRES_PAYMENT_PASSWORD=changeme

# --- MongoDB - Notification Service ---
MONGO_INITDB_ROOT_USERNAME=notification_service
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=notification_db

# --- Redis ---
REDIS_PASSWORD=changeme
